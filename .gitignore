# Terraform working files
.terraform/
**/.terraform/**

# State may contain secrets (for example the Firebase key in envs/sandbox/push-test)
*.tfstate
*.tfstate.*

# Real variable and backend files; keep only the *.example templates
*.tfvars
!*.tfvars.example
backend.hcl
**/backend.hcl

# Saved plans can contain sensitive values
*.tfplan
tfplan
**/tfplan

# Credentials
*.json
!modules/pod-identity/lbc-iam-policy.json
*service-account*key*
*firebase*key*
*.pem
*.key
