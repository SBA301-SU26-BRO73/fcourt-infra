aws_region = "ap-southeast-1"

# Only this repository (refs dev and main) may assume the CI push role.
github_repository = "SBA301-SU26-BRO73/fcourt-backend"
github_refs       = ["dev", "main"]

# Set to false if the account already has a token.actions.githubusercontent.com OIDC provider
# (aws iam list-open-id-connect-providers); it is then looked up instead of created.
create_github_oidc_provider = true

tagged_image_count = 3

# Budget lives here so it survives scripts/down.sh. Alerts at 5/10/15 USD actual plus 100% forecast.
monthly_budget_usd = 20
budget_email       = "REPLACE_WITH_BUDGET_EMAIL@example.com" # required
