aws_region      = "ap-southeast-1"
vpc_cidr        = "10.40.0.0/16"
cluster_version = "1.34"
eks_instance_types = ["t3a.xlarge", "t3.xlarge", "m5a.xlarge", "m5.xlarge"]
eks_capacity_type = "SPOT"
eks_root_volume_size = 20
eks_min_size        = 1
eks_desired_size    = 1
eks_max_size        = 2
nodes_in_public_subnets = true

# Use trusted admin-role and client IP values for your account; do not leave wildcards.
admin_principal_arns        = ["arn:aws:iam::123456789012:role/FCourtPlatformAdmin"]
cluster_public_access_cidrs = ["203.0.113.10/32"]

# Inject TF_VAR_firebase_service_account_json through an approved secret store.
# Never paste Firebase JSON into this file.
enable_reminder = false
enable_flow_logs = false
enable_interface_endpoints = false
eks_cluster_log_types = []
cloudwatch_log_retention_days = 3
enable_secrets_encryption = false
monthly_budget_usd = 20
budget_email = "alerts@example.com"
