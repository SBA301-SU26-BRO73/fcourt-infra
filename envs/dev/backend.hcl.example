# Copy to backend.hcl and replace every placeholder with your team's actual state settings.
# Do not commit the completed backend.hcl. The S3 bucket must already exist and be secured.
bucket       = "REPLACE_WITH_EXISTING_TERRAFORM_STATE_BUCKET"
key          = "fcourt/dev/terraform.tfstate"
region       = "ap-southeast-1"
encrypt      = true
use_lockfile = true
