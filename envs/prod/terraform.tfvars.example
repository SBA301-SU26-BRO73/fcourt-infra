aws_region      = "ap-southeast-1"
vpc_cidr        = "10.50.0.0/16"
cluster_version = "1.34"
eks_instance_types = ["m7i.large"]
eks_min_size        = 3
eks_desired_size    = 3
eks_max_size        = 9

# Supply a production admin role and trusted client CIDRs.
admin_principal_arns        = ["arn:aws:iam::123456789012:role/FCourtProductionAdmin"]
cluster_public_access_cidrs = ["203.0.113.10/32"]

# Inject TF_VAR_firebase_service_account_json through an approved secret store.
# Never paste Firebase JSON into this file.
enable_reminder = false
enable_flow_logs = true
enable_ecr_endpoints = false
