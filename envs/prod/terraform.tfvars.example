aws_region      = "ap-southeast-1"
vpc_cidr        = "10.40.0.0/16"

# 1.34 leaves standard support on 2026-12-02 and then costs 0.60 USD/h for the control plane. Use 1.35 or newer.
cluster_version = "1.35"

# Cheapest working demo: 2 x 8 GiB Spot nodes (t3.large 2 vCPU / 8 GiB). 12 Spring Boot services, Eureka, the gateway plus
# PostgreSQL, Kafka, Redis and Argo CD need about 9 GiB of memory requests (12 GiB or more actual use), so one 8 GiB node is not enough.
eks_instance_types   = ["t3.large", "t3a.large", "m5.large", "m6i.large", "m6a.large", "m7i.large"]
eks_capacity_type    = "SPOT" # use "ON_DEMAND" on demo day if an interruption is unacceptable
eks_root_volume_size = 20
eks_min_size         = 2
eks_desired_size     = 2
eks_max_size         = 3

# Nodes in public subnets, no NAT gateway (saves about 0.06 USD/h). Short demos only.
nodes_in_public_subnets = true

# Use trusted admin principal and your current public IP /32 (curl -s https://checkip.amazonaws.com).
# The IP changes when the ISP reassigns it; re-check before every bring-up.
admin_principal_arns        = ["arn:aws:iam::123456789012:user/YOUR_IAM_USER"]
cluster_public_access_cidrs = ["203.0.113.10/32"]

# Inject TF_VAR_firebase_service_account_json through an approved secret store.
# Never paste Firebase JSON into this file.
enable_reminder            = false
enable_flow_logs           = false
enable_interface_endpoints = false
eks_cluster_log_types      = []
cloudwatch_log_retention_days = 3
enable_secrets_encryption  = false
